# Copia este archivo a server/.env y pon tus valores. .env NUNCA se sube al repo.
OPENROUTER_API_KEY=
# Modelo del motor. Recomendado: rápido y barato, sin razonamiento largo.
MODEL=google/gemini-2.5-flash-lite
# 1 = nunca llama al modelo, usa las salidas de ejemplo (para ensayar el demo sin gastar)
SIM_MODE=0
PORT=3001
