{
  "name": "agent-canvas-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:backend": "node --env-file-if-exists=.env backend/server.mjs",
    "build": "tsc && vite build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "node --test backend/test/*.test.mjs",
    "test:frontend": "node --experimental-strip-types --test src/conversation-store.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
